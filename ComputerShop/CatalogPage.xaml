<Page x:Class="ComputerShop.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="tbSearch" Width="250" Height="28" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="cbCategory" Width="180" Height="28" Margin="10,0,0,0"/>
            <Button Content="Найти" Width="80" Height="28" Margin="10,0,0,0" Click="BtnSearch_Click"/>
            <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="30,0,5,0"/>
            <TextBox x:Name="tbQty" Width="50" Height="28" Text="1" VerticalContentAlignment="Center"/>
            <Button x:Name="btnAdd" Content="В корзину" Width="100" Height="28" Margin="10,0,0,0" Click="BtnAddToCart_Click"/>
        </StackPanel>
        <ListView x:Name="lvProducts">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" Width="260" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Категория" Width="120" DisplayMemberBinding="{Binding CategoryName}"/>
                    <GridViewColumn Header="Производитель" Width="140" DisplayMemberBinding="{Binding ManufacturerName}"/>
                    <GridViewColumn Header="Цена" Width="100" DisplayMemberBinding="{Binding Price}"/>
                    <GridViewColumn Header="На складе" Width="90" DisplayMemberBinding="{Binding Stock}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Page>
