<Window x:Class="ComputerShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин компьютерной техники" Height="620" Width="940"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Каталог" Click="MenuCatalog_Click"/>
            <MenuItem x:Name="miCart" Header="Корзина" Click="MenuCart_Click"/>
            <MenuItem Header="Заказы" Click="MenuOrders_Click"/>
            <MenuItem Header="Выход" Click="MenuExit_Click"/>
        </Menu>
        <Frame x:Name="MainFrame"/>
    </DockPanel>
</Window>
