<Window x:Class="ComputerShop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="380" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="30">
        <TextBlock Text="Магазин компьютерной техники" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Авторизация" FontSize="14" Margin="0,5,0,20"/>
        <TextBlock Text="Логин:"/>
        <TextBox x:Name="tbLogin" Height="28" Margin="0,5,0,10"/>
        <TextBlock Text="Пароль:"/>
        <PasswordBox x:Name="pbPassword" Height="28" Margin="0,5,0,20"/>
        <Button Content="Войти" Height="32" Click="BtnLogin_Click"/>
        <Button Content="Регистрация" Height="32" Margin="0,10,0,0" Click="BtnRegister_Click"/>
    </StackPanel>
</Window>
