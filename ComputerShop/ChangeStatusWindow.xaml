<Window x:Class="ComputerShop.ChangeStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статус заказа" Height="180" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Новый статус:"/>
        <ComboBox x:Name="cbStatus" Height="28" Margin="0,8,0,15"/>
        <Button Content="OK" Height="28" Click="BtnOk_Click"/>
    </StackPanel>
</Window>
