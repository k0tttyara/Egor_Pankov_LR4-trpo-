<Window x:Class="ComputerShop.OrderItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав заказа" Height="420" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="10">
        <ListView x:Name="lvItems">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" Width="240" DisplayMemberBinding="{Binding ProductName}"/>
                    <GridViewColumn Header="Кол-во" Width="70" DisplayMemberBinding="{Binding Quantity}"/>
                    <GridViewColumn Header="Цена" Width="90" DisplayMemberBinding="{Binding Price}"/>
                    <GridViewColumn Header="Сумма" Width="90" DisplayMemberBinding="{Binding Sum}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
