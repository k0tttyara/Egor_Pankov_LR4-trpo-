<Page x:Class="ComputerShop.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Удалить выбранное" Width="160" Height="28" HorizontalAlignment="Left" Click="BtnRemove_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <TextBlock x:Name="tbTotal" Text="Итого: 0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,20,0"/>
                <Button Content="Оформить заказ" Width="140" Height="30" Click="BtnOrder_Click"/>
            </StackPanel>
        </StackPanel>
        <ListView x:Name="lvCart">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" Width="260" DisplayMemberBinding="{Binding Product.Name}"/>
                    <GridViewColumn Header="Цена" Width="100" DisplayMemberBinding="{Binding Price}"/>
                    <GridViewColumn Header="Кол-во" Width="70" DisplayMemberBinding="{Binding Quantity}"/>
                    <GridViewColumn Header="Сумма" Width="100" DisplayMemberBinding="{Binding Sum}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Page>
